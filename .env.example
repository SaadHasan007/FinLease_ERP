# ========================================
# FinLease — Environment Configuration
# ========================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# Database
DB_NAME=finlease
DB_USER=finlease_user
DB_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://finlease_user:change_me_in_production@localhost:5432/finlease
DATABASE_URL_SYNC=postgresql://finlease_user:change_me_in_production@localhost:5432/finlease

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=FinLease
APP_VERSION=1.0.0

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# AI (Optional — AI features degrade gracefully if not set)
# AI_API_KEY=
# AI_MODEL=
